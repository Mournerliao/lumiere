<Window
    x:Class="Lumiere.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">
  <Grid
      x:Name="RootGrid"
      Background="Black"
      IsTabStop="True"
      KeyDown="OnRootGridKeyDown">

    <SwapChainPanel
        x:Name="PreviewSwapChainPanel"
        Canvas.ZIndex="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" />

    <Canvas
        x:Name="CropCanvas"
        Canvas.ZIndex="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        IsHitTestVisible="True"
        PointerCanceled="OnCropCanvasPointerCanceled"
        PointerCaptureLost="OnCropCanvasPointerCaptureLost"
        PointerMoved="OnCropCanvasPointerMoved"
        PointerPressed="OnCropCanvasPointerPressed"
        PointerReleased="OnCropCanvasPointerReleased">
      <shapes:Rectangle
          x:Name="TopMaskRectangle"
          Fill="#99000000"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="LeftMaskRectangle"
          Fill="#99000000"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="RightMaskRectangle"
          Fill="#99000000"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="BottomMaskRectangle"
          Fill="#99000000"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="CropOuterBorderRectangle"
          Stroke="#F9000000"
          StrokeThickness="4"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="CropInnerBorderRectangle"
          Stroke="#FFFFFFFF"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="TopLeftCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="TopCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="TopRightCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="RightCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="BottomRightCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="BottomCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="BottomLeftCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
      <shapes:Rectangle
          x:Name="LeftCropHandleRectangle"
          Fill="#FFFFFFFF"
          Stroke="#F9000000"
          StrokeThickness="2"
          Visibility="Collapsed" />
    </Canvas>

    <Grid
        Canvas.ZIndex="2"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
      <Border
          x:Name="StatusPanelBorder"
          Margin="16"
          Padding="10"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Background="#CC111827"
          BorderBrush="#80F9FAFB"
          BorderThickness="1"
          CornerRadius="8">
        <StackPanel
            MinWidth="220"
            MaxWidth="360"
            Spacing="4">
          <TextBlock
              x:Name="StatusLabelTextBlock"
              Foreground="#F9FAFB"
              FontSize="13"
              FontWeight="SemiBold"
              Text="Initializing preview" />
          <TextBlock
              x:Name="StatusMessageTextBlock"
              Foreground="#E5E7EB"
              FontSize="11"
              MaxLines="2"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border
          x:Name="FidelityPanelBorder"
          Margin="16"
          Padding="10"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Bottom"
          Background="#CC111827"
          BorderBrush="#80F9FAFB"
          BorderThickness="1"
          CornerRadius="8">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel
              Grid.Column="0"
              MinWidth="220"
              MaxWidth="560"
              Spacing="4">
            <TextBlock
                x:Name="FidelityLabelTextBlock"
                Foreground="#F9FAFB"
                FontSize="12"
                FontWeight="SemiBold"
                Text="Output unvalidated" />
            <TextBlock
                x:Name="FidelityDetailTextBlock"
                Foreground="#D1D5DB"
                FontSize="11"
                MaxLines="2"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="CropSizeTextBlock"
                Foreground="#E5E7EB"
                FontSize="11"
                FontWeight="SemiBold"
                Text="Select a region" />
          </StackPanel>

          <StackPanel
              Grid.Column="1"
              MinWidth="180"
              MaxWidth="420"
              Spacing="6"
              VerticalAlignment="Center">
            <Button
                x:Name="ToggleTechnicalDetailsButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Left"
                Click="OnToggleTechnicalDetailsClick"
                Content="Technical details &gt;"
                FontSize="12"
                Foreground="#9CA3AF" />
            <Border
                x:Name="TechnicalDetailsBorder"
                Background="#44111827"
                CornerRadius="4"
                Padding="8"
                Visibility="Collapsed">
              <TextBlock
                  x:Name="TechnicalDetailTextBlock"
                  Foreground="#D1D5DB"
                  FontSize="11"
                  TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <StackPanel
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <Button
                x:Name="ConfirmButton"
                Click="OnConfirmButtonClick"
                ClickMode="Press"
                Content="Confirm crop"
                IsEnabled="False" />
            <Button
                x:Name="CancelButton"
                Click="OnCancelButtonClick"
                ClickMode="Press"
                Content="Cancel" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
