<Application
    x:Class="Lumiere.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF111111" />
      <SolidColorBrush x:Key="PanelBrush" Color="#FF111414" />
      <SolidColorBrush x:Key="SecondaryPanelBrush" Color="#FF151819" />
      <SolidColorBrush x:Key="MicaSurfaceBrush" Color="#E6111414" />
      <SolidColorBrush x:Key="MicaMenuSurfaceBrush" Color="#CC111414" />
      <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA0A0A0" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF7067FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF19192B" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="#805B55D6" />
      <SolidColorBrush x:Key="PrimaryActionBrush" Color="#1A7067FF" />
      <SolidColorBrush x:Key="PrimaryActionBorderBrush" Color="#407067FF" />
      <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#2E7067FF" />
      <SolidColorBrush x:Key="PrimaryActionHoverBorderBrush" Color="#737067FF" />
      <SolidColorBrush x:Key="SecondaryPanelHoverBrush" Color="#FF252829" />
      <SolidColorBrush x:Key="SecondaryBorderHoverBrush" Color="#40FFFFFF" />
      <SolidColorBrush x:Key="MenuHoverBrush" Color="#B334363A" />
      <SolidColorBrush x:Key="MenuPressedBrush" Color="#CC34363A" />
      <SolidColorBrush x:Key="MenuFocusBorderBrush" Color="#807067FF" />
      <SolidColorBrush x:Key="MenuDestructiveHoverBrush" Color="#1AEF4444" />
      <SolidColorBrush x:Key="MenuDestructivePressedBrush" Color="#33EF4444" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />

      <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,8" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="8,0,0,8" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
