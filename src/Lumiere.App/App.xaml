<Application
    x:Class="Lumiere.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF111111" />
      <SolidColorBrush x:Key="PanelBrush" Color="#C0202020" />
      <SolidColorBrush x:Key="BorderBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA0A0A0" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A0078D4" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="#800078D4" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />

      <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,8" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="8,0,0,8" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
