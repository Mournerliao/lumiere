<Application
    x:Class="Lumiere.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF111111" />
      <SolidColorBrush x:Key="PanelBrush" Color="#FF111414" />
      <SolidColorBrush x:Key="SecondaryPanelBrush" Color="#FF151819" />
      <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA0A0A0" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF7067FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF19192B" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="#805B55D6" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />

      <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,8" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="8,0,0,8" />
      </Style>

      <Style x:Key="CompactSwitchToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#FF3A3D40" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleSwitch">
              <Grid
                  Width="44"
                  Height="24"
                  Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="ToggleStates">
                    <VisualState x:Name="Off" />
                    <VisualState x:Name="On">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Track"
                            Storyboard.TargetProperty="Background">
                          <DiscreteObjectKeyFrame
                              KeyTime="0"
                              Value="#FFC9C0F7" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Knob"
                            Storyboard.TargetProperty="HorizontalAlignment">
                          <DiscreteObjectKeyFrame
                              KeyTime="0"
                              Value="Right" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Knob"
                            Storyboard.TargetProperty="Fill">
                          <DiscreteObjectKeyFrame
                              KeyTime="0"
                              Value="#FF0F1113" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Dragging" />
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="Disabled">
                      <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="TrackRoot"
                            Storyboard.TargetProperty="Opacity"
                            To="0.7"
                            Duration="0" />
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border
                    x:Name="TrackRoot"
                    CornerRadius="12">
                  <Border
                      x:Name="Track"
                      Background="#FF3A3D40"
                      CornerRadius="12">
                    <Ellipse
                        x:Name="Knob"
                        Width="16"
                        Height="16"
                        Margin="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="#FFA7A9AA" />
                  </Border>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
