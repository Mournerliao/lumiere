<Application
    x:Class="Lumiere.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF111111" />
      <SolidColorBrush x:Key="PanelBrush" Color="#FF111414" />
      <SolidColorBrush x:Key="SecondaryPanelBrush" Color="#FF151819" />
      <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA0A0A0" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF7067FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF19192B" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="#805B55D6" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF10B981" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />

      <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,8" />
      </Style>

      <Style x:Key="SegmentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
                <ContentPresenter
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="8,0,0,8" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
