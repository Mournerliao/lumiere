<UserControl
    x:Class="Lumiere.App.CaptureActionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
  <Button
      x:Name="ActionButton"
      HorizontalAlignment="Stretch"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch"
      AutomationProperties.HelpText="{Binding Description, ElementName=Root}"
      AutomationProperties.Name="{Binding Title, ElementName=Root}"
      Background="Transparent"
      BorderThickness="0"
      Click="OnActionButtonClick"
      CornerRadius="8"
      Padding="0"
      ToolTipService.ToolTip="{Binding Description, ElementName=Root}">
    <Border
        MinHeight="64"
        Padding="16,12"
        Background="{Binding Background, ElementName=Root}"
        BorderBrush="{Binding BorderBrush, ElementName=Root}"
        BorderThickness="1"
        CornerRadius="8">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Width="24"
            Height="24"
            VerticalAlignment="Center">
          <ic:FluentIcon
              Foreground="{Binding IconForeground, ElementName=Root}"
              Icon="{Binding Icon, ElementName=Root}"
              IconSize="Size20"
              IconVariant="Regular" />
        </Grid>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
          <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{Binding Foreground, ElementName=Root}"
              Text="{Binding Title, ElementName=Root}" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{Binding SecondaryForeground, ElementName=Root}"
                Text="Shortcut" />
            <Border
                Padding="5,1"
                Background="#33171B1D"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                CornerRadius="4">
              <TextBlock
                  FontFamily="Consolas"
                  FontSize="11"
                  Foreground="{Binding ShortcutForeground, ElementName=Root}"
                  Text="{Binding ShortcutText, ElementName=Root}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Button>
</UserControl>
