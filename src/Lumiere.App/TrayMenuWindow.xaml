<Window
    x:Class="Lumiere.App.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:Lumiere.App">
  <Border
      x:Name="RootGrid"
      MinWidth="220"
      MaxWidth="280"
      Padding="4"
      Background="{StaticResource MicaMenuSurfaceBrush}"
      RequestedTheme="Dark">
    <StackPanel Spacing="0">

      <Grid Padding="10,8" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Width="32"
            Height="32"
            Background="{StaticResource AccentSoftBrush}"
            CornerRadius="8">
          <ic:FluentIcon
              Foreground="{StaticResource AccentBrush}"
              Icon="Layer"
              IconSize="Size20"
              IconVariant="Regular" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{StaticResource TextBrush}"
              Text="Lumiere" />
          <TextBlock
              x:Name="HdrStatusLabel"
              FontSize="10"
              Foreground="{StaticResource MutedTextBrush}"
              Text="" />
          <TextBlock
              x:Name="FidelityClaimLabel"
              FontSize="10"
              Foreground="{StaticResource MutedTextBrush}"
              Text="" />
          <TextBlock
              x:Name="HdrAlertLabel"
              FontSize="10"
              Foreground="{StaticResource WarningBrush}"
              Text=""
              Visibility="Collapsed" />
        </StackPanel>
      </Grid>

      <local:TrayMenuItemRow
          x:Name="FullscreenItem"
          Icon="Camera"
          Label="Full Screen" />
      <local:TrayMenuItemRow
          x:Name="RegionItem"
          Icon="Layer"
          Label="Region" />

      <Border
          Margin="8,4"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="0,1,0,0" />

      <local:TrayMenuItemRow
          x:Name="OpenItem"
          Icon="Desktop"
          Label="Open Lumiere" />
      <local:TrayMenuItemRow
          x:Name="SettingsItem"
          Icon="Settings"
          Label="Settings" />
      <local:TrayMenuItemRow
          x:Name="QuitItem"
          Icon="Power"
          IsDestructive="True"
          Label="Quit" />

    </StackPanel>
  </Border>
</Window>
