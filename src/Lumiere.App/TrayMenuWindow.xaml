<Window
    x:Class="Lumiere.App.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:Lumiere.App">
  <Border
      x:Name="RootGrid"
      MinWidth="220"
      MaxWidth="280"
      Padding="4"
      Background="#CC111414"
      CornerRadius="12"
      RequestedTheme="Dark">
    <StackPanel Spacing="0">

      <Grid Padding="12,10" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Width="32"
            Height="32"
            Background="{StaticResource AccentSoftBrush}"
            CornerRadius="8">
          <ic:FluentIcon
              Foreground="{StaticResource AccentBrush}"
              Icon="Layer"
              IconSize="Size20"
              IconVariant="Regular" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{StaticResource TextBrush}"
              Text="Lumiere" />
          <TextBlock
              x:Name="HdrStatusLabel"
              FontSize="11"
              Foreground="{StaticResource MutedTextBrush}"
              Text="" />
        </StackPanel>
      </Grid>

      <Border
          Margin="12,4"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0" />

      <TextBlock
          Margin="12,8,12,4"
          FontSize="11"
          FontWeight="SemiBold"
          Foreground="{StaticResource MutedTextBrush}"
          Text="Capture" />

      <local:TrayMenuItemRow
          x:Name="FullscreenItem"
          Icon="Camera"
          Label="Full Screen" />
      <local:TrayMenuItemRow
          x:Name="RegionItem"
          Icon="Crop"
          Label="Region" />
      <local:TrayMenuItemRow
          x:Name="OpenItem"
          Icon="Desktop"
          Label="Open Lumiere" />

      <Border
          Margin="12,4"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0" />

      <local:TrayMenuItemRow
          x:Name="SettingsItem"
          Icon="Settings"
          Label="Settings" />

      <Border
          Margin="12,4"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0" />

      <local:TrayMenuItemRow
          x:Name="QuitItem"
          Icon="Power"
          IsDestructive="True"
          Label="Quit" />

    </StackPanel>
  </Border>
</Window>
