          </StackPanel>

          <StackPanel
              AutomationProperties.Name="About settings section"
              AutomationProperties.HelpText="Version and product information."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE946;"
                Title="ABOUT" />
            <Border
                x:Name="SettingsAboutInfoPanel"
                Padding="16,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel Spacing="4">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      x:Name="SettingsAboutAppNameText"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Lumiere" />
                  <TextBlock
                      x:Name="SettingsAboutVersionText"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontSize="12"
                      FontFamily="Cascadia Mono, Consolas"
                      Foreground="{StaticResource SubtleTextBrush}"
                      Text="Version" />
                </Grid>
                <TextBlock
                    x:Name="SettingsAboutDescriptionText"
                    FontSize="11"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Native screenshot reference for HDR-first capture."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
