<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource MicaSurfaceBrush}"
      RequestedTheme="Dark">
    <Grid x:Name="MainPanelRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <Border
          x:Name="HeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="12">
            <Border
                Width="32"
                Height="32"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="8">
              <ic:FluentIcon
                  Foreground="{StaticResource AccentBrush}"
                  Icon="Layer"
                  IconSize="Size20"
                  IconVariant="Regular" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Lumiere" />
          </StackPanel>
          <Button
              x:Name="SettingsButton"
              Grid.Column="1"
              Width="28"
              Height="28"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Open the native settings shell without stopping the current capture session."
              AutomationProperties.Name="Open settings"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Settings">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="16"
                Glyph="&#xE713;" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="2"
          Padding="20,18"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

          <StackPanel Spacing="8">
            <local:CaptureActionCard
                x:Name="SelectCaptureTargetButton"
                Background="{StaticResource PrimaryActionBrush}"
                BorderBrush="{StaticResource PrimaryActionBorderBrush}"
                Click="OnSelectCaptureTargetClick"
                Description="Capture the current display"
                HoverBackground="{StaticResource PrimaryActionHoverBrush}"
                HoverBorderBrush="{StaticResource PrimaryActionHoverBorderBrush}"
                Icon="Camera"
                IconBackground="{StaticResource AccentSoftBrush}"
                IconBorderBrush="{StaticResource AccentBorderBrush}"
                IconForeground="{StaticResource AccentBrush}"
                SecondaryForeground="{StaticResource MutedTextBrush}"
                ShortcutForeground="{StaticResource TextBrush}"
                ShortcutText="Not assigned"
                Title="Full Screen" />

            <local:CaptureActionCard
                x:Name="RegionSelectButton"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                Click="OnRegionCaptureClick"
                Description="Select a region by dragging"
                HoverBackground="{StaticResource SecondaryPanelHoverBrush}"
                HoverBorderBrush="{StaticResource SecondaryBorderHoverBrush}"
                Icon="Layer"
                IconBackground="{StaticResource SecondaryPanelBrush}"
                IconBorderBrush="{StaticResource BorderBrush}"
                IconForeground="{StaticResource MutedTextBrush}"
                SecondaryForeground="{StaticResource MutedTextBrush}"
                ShortcutForeground="{StaticResource SubtleTextBrush}"
                ShortcutText="Not assigned"
                Title="Region" />
          </StackPanel>

          <Grid
              Margin="0,8,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="TargetHdrStatusPill"
                MinHeight="66"
                Padding="12,10"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon
                      x:Name="TargetHdrStatusGlyph"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="13"
                      Foreground="{StaticResource MutedTextBrush}"
                      Glyph="&#xE121;" />
                  <Ellipse
                      x:Name="TargetHdrStatusDotInline"
                      Width="6"
                      Height="6"
                      VerticalAlignment="Center"
                      Fill="{StaticResource MutedTextBrush}" />
                  <TextBlock
                      x:Name="TargetHdrStatusLabel"
                      VerticalAlignment="Center"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Checking HDR"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    x:Name="TargetHdrStatusDetail"
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="HDR preview status is being checked."
                    TextWrapping="WrapWholeWords" />
              </StackPanel>
            </Border>
          </Grid>

          <Border
              x:Name="OutputResultPanel"
              Margin="0,6,0,0"
              Padding="12,10"
              Background="{StaticResource SecondaryPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    x:Name="OutputResultGlyph"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Foreground="{StaticResource SuccessBrush}"
                    Glyph="&#xE8C8;" />
                <StackPanel Spacing="1">
                  <TextBlock
                      x:Name="OutputResultTitle"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Ready" />
                  <TextBlock
                      FontSize="10"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="sRGB Visual Match output for clipboard and file use." />
                </StackPanel>
              </StackPanel>
              <TextBlock
                  x:Name="OutputResultDetail"
                  FontSize="10"
                  Foreground="{StaticResource MutedTextBrush}"
                  Text="No capture output has completed yet."
                  TextWrapping="WrapWholeWords" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <InfoBar
          x:Name="HdrAlertInfoBar"
          Grid.Row="3"
          Margin="12,0"
          Closed="OnHdrAlertInfoBarClosed"
          IsClosable="True"
          IsOpen="False"
          Severity="Warning"
          Visibility="Collapsed" />

      <Border
          Grid.Row="4"
          Padding="20,0"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <FontIcon
                x:Name="TrustStatusGlyph"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Foreground="{StaticResource MutedTextBrush}"
                Glyph="&#xE121;" />
            <Ellipse
                x:Name="TrustStatusDot"
                Width="6"
                Height="6"
                VerticalAlignment="Center"
                Fill="{StaticResource MutedTextBrush}" />
            <TextBlock
                x:Name="TrustStatusLabel"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="Checking HDR" />
          </StackPanel>
          <Button
              x:Name="MinimizeButton"
              Grid.Column="1"
              Width="28"
              Height="28"
              MinWidth="0"
              VerticalAlignment="Center"
              IsEnabled="False"
              AutomationProperties.Name="Minimize to background"
              AutomationProperties.HelpText="Hide the window to the system tray. The app continues running in the background."
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnMinimizeButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Minimize to tray">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="14"
                Glyph="&#xE921;" />
          </Button>
        </Grid>
      </Border>

    </Grid>

    <Grid
        x:Name="SettingsPanelRoot"
        Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border
          x:Name="SettingsHeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button
              x:Name="SettingsBackButton"
              Width="32"
              Height="32"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Return to the main capture panel without stopping capture."
              AutomationProperties.Name="Back to main panel"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsBackButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Back">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="15"
                Glyph="&#xE72B;" />
          </Button>
          <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="1">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Settings" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="1"
          Padding="20,20,20,20"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
          <StackPanel
              AutomationProperties.Name="Shortcuts settings section"
              AutomationProperties.HelpText="Keyboard shortcuts for fullscreen and region capture."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE765;"
                Title="SHORTCUTS" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <Grid
                    MinHeight="56"
                    ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Full Screen" />
                  <Button
                      x:Name="SettingsFullscreenShortcutButton"
                      Grid.Column="1"
                      MinWidth="108"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="Choose the fullscreen capture shortcut."
                      AutomationProperties.Name="Edit fullscreen shortcut"
                      Click="OnFullscreenShortcutClick">
                    <TextBlock
                        x:Name="SettingsFullscreenShortcutValueText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Not assigned" />
                  </Button>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid
                    MinHeight="56"
                    ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Region" />
                  <Button
                      x:Name="SettingsRegionShortcutButton"
                      Grid.Column="1"
                      MinWidth="108"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="Choose the region capture shortcut."
                      AutomationProperties.Name="Edit region shortcut"
                      Click="OnRegionShortcutClick">
                    <TextBlock
                        x:Name="SettingsRegionShortcutValueText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Not assigned" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>

          <StackPanel
              AutomationProperties.Name="HDR alerts settings section"
              AutomationProperties.HelpText="HDR alert preference can be changed for the current session."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE7F4;"
                Title="HDR" />
            <Border
                Padding="16,0"
                HorizontalAlignment="Stretch"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
	              <StackPanel>
	                <Grid MinHeight="64" ColumnSpacing="14">
	                  <Grid.ColumnDefinitions>
	                    <ColumnDefinition Width="*" />
	                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="HDR alerts" />
                  <ToggleSwitch
                      x:Name="SettingsHdrAlertsToggleSwitch"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Show warnings when HDR is unavailable, degraded, unsupported, or failed."
                      AutomationProperties.Name="HDR alerts"
	                      OffContent=""
	                      OnContent=""
	                      Toggled="OnSettingsHdrAlertsToggled" />
	                </Grid>
	              </StackPanel>
	            </Border>
	          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Output settings section"
              AutomationProperties.HelpText="Supported output destination and clipboard image preferences can be changed here."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE8B7;"
                Title="OUTPUT" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <StackPanel Padding="0,16,0,18" Spacing="10">
                  <TextBlock
                      CharacterSpacing="80"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="DESTINATION" />
                  <Border
                      Padding="12,6"
                      AutomationProperties.HelpText="Choose where completed captures are written."
                      AutomationProperties.Name="Destination"
                      Background="#2217191C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                    <RadioButtons
                        x:Name="SettingsDestinationRadioButtons"
                        MaxColumns="3"
                        SelectionChanged="OnSettingsDestinationSelectionChanged">
                      <x:String>Clipboard</x:String>
                      <x:String>Folder</x:String>
                      <x:String>Both</x:String>
                    </RadioButtons>
                  </Border>
                </StackPanel>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <StackPanel x:Name="SettingsSavePathRow" Padding="0,16,0,18">
                  <TextBlock
                      Margin="0,0,0,8"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Save Path" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="SettingsSavePathValueBorder"
                        Padding="10,7"
                        VerticalAlignment="Center"
                        Background="#1A1D2024"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                      <TextBlock
                          x:Name="SettingsSavePathValueText"
                          FontSize="11"
                          FontFamily="Cascadia Mono, Consolas"
                          Foreground="{StaticResource MutedTextBrush}"
                          Text="Not configured"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap" />
                    </Border>
                    <Button
                        x:Name="SettingsSavePathBrowseButton"
                        Grid.Column="1"
                        Width="Auto"
                        MinWidth="80"
                        Padding="10,7"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Browse for save folder"
                        Click="OnSettingsSavePathBrowseClick">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="12"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="Browse" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Open after capture" />
                  <ToggleSwitch
                      x:Name="SettingsOpenAfterCaptureToggleSwitch"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Runs only when folder output produces a file artifact."
                      AutomationProperties.Name="After capture action"
                      OffContent=""
                      OnContent=""
                      Toggled="OnSettingsAfterCaptureToggled" />
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Timestamp" />
                  <ToggleSwitch
                      x:Name="SettingsTimestampToggleSwitch"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Timestamp naming controls whether folder output uses safe invariant filenames."
                      AutomationProperties.Name="Timestamp naming"
                      OffContent=""
                      OnContent=""
                      Toggled="OnSettingsTimestampToggled" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel
              x:Name="SettingsClipboardSection"
              AutomationProperties.Name="Clipboard settings section"
              AutomationProperties.HelpText="Copy-as-image controls basic clipboard usability."
              Visibility="Collapsed"
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE8C8;"
                Title="CLIPBOARD" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <Grid MinHeight="64" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"
                    Text="Copy as image" />
                <ToggleSwitch
                    x:Name="SettingsCopyAsImageToggleSwitch"
                    Grid.Column="1"
                    AutomationProperties.HelpText="Copy-as-image controls basic clipboard usability and does not mean validated HDR preservation."
                    AutomationProperties.Name="Copy as image"
                    OffContent=""
                    OnContent=""
                    Toggled="OnSettingsCopyAsImageToggled" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="About settings section"
              AutomationProperties.HelpText="Version and product information."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE946;"
                Title="ABOUT" />
            <Border
                x:Name="SettingsAboutInfoPanel"
                Padding="16,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel Spacing="4">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      x:Name="SettingsAboutAppNameText"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Lumiere" />
                  <TextBlock
                      x:Name="SettingsAboutVersionText"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontSize="12"
                      FontFamily="Cascadia Mono, Consolas"
                      Foreground="{StaticResource SubtleTextBrush}"
                      Text="Version" />
                </Grid>
                <TextBlock
                    x:Name="SettingsAboutDescriptionText"
                    FontSize="11"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Native screenshot reference for HDR-first capture."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
