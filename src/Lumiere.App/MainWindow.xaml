<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource PanelBrush}"
      RequestedTheme="Dark">
    <Grid x:Name="MainPanelRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>

      <Border
          x:Name="HeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="10">
            <Border
                Width="24"
                Height="24"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="6">
              <ic:FluentIcon
                  Foreground="{StaticResource AccentBrush}"
                  Icon="Layer"
                  IconSize="Size20"
                  IconVariant="Regular" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Lumiere" />
          </StackPanel>
          <Button
              x:Name="SettingsButton"
              Grid.Column="1"
              Width="28"
              Height="28"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Open the native settings shell without stopping the current capture session."
              AutomationProperties.Name="Open settings"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Settings">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="16"
                Glyph="&#xE713;" />
          </Button>
        </Grid>
      </Border>

      <Grid
          Grid.Row="1"
          Padding="20,18">
        <StackPanel
            VerticalAlignment="Center"
            Spacing="8">

          <local:CaptureActionCard
              x:Name="SelectCaptureTargetButton"
              Background="{StaticResource AccentSoftBrush}"
              BorderBrush="{StaticResource AccentBorderBrush}"
              Click="OnSelectCaptureTargetClick"
              Description="Capture the current display"
              Icon="Camera"
              IconBackground="{StaticResource AccentSoftBrush}"
              IconBorderBrush="{StaticResource AccentBorderBrush}"
              IconForeground="{StaticResource AccentBrush}"
              SecondaryForeground="{StaticResource MutedTextBrush}"
              ShortcutForeground="{StaticResource TextBrush}"
              ShortcutText="Not assigned"
              Title="Full Screen" />

          <local:CaptureActionCard
              x:Name="RegionSelectButton"
              Background="{StaticResource SecondaryPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              Click="OnRegionCaptureClick"
              Description="Select a region by dragging"
              Icon="Layer"
              IconBackground="{StaticResource SecondaryPanelBrush}"
              IconBorderBrush="{StaticResource BorderBrush}"
              IconForeground="{StaticResource MutedTextBrush}"
              SecondaryForeground="{StaticResource MutedTextBrush}"
              ShortcutForeground="{StaticResource SubtleTextBrush}"
              ShortcutText="Not assigned"
              Title="Region" />

        </StackPanel>
      </Grid>

      <Border
          Grid.Row="2"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <ic:FluentIcon
                x:Name="TrustStatusGlyph"
                VerticalAlignment="Center"
                Foreground="{StaticResource MutedTextBrush}"
                Icon="Clock"
                IconSize="Size16"
                IconVariant="Regular" />
            <Ellipse
                x:Name="TrustStatusDot"
                Width="6"
                Height="6"
                VerticalAlignment="Center"
                Fill="{StaticResource MutedTextBrush}" />
            <TextBlock
                x:Name="TrustStatusLabel"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="Checking HDR" />
          </StackPanel>
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="11"
              Foreground="{StaticResource MutedTextBrush}"
              AutomationProperties.Name="Minimize to background pending"
              Text="Minimize"
              ToolTipService.ToolTip="Background tray behavior arrives in Epic 7" />
        </Grid>
      </Border>
    </Grid>

    <Grid
        x:Name="SettingsPanelRoot"
        Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border
          x:Name="SettingsHeaderDragArea"
          Grid.Row="0"
          Padding="14,0,20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button
              x:Name="SettingsBackButton"
              Width="32"
              Height="32"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Return to the main capture panel without stopping capture."
              AutomationProperties.Name="Back to main panel"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsBackButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Back">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="15"
                Glyph="&#xE72B;" />
          </Button>
          <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="1">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Settings" />
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="Native shell, pending behavior clearly marked" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="1"
          Padding="20,16,20,20"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <StackPanel
              AutomationProperties.Name="Shortcuts settings section"
              AutomationProperties.HelpText="Shortcut editing arrives in a later story."
              Spacing="8">
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="SHORTCUTS" />
            <Border
                Padding="14,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
              <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Full Screen" />
                    <TextBlock
                        x:Name="SettingsFullscreenShortcutText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Shortcut not assigned" />
                  </StackPanel>
                  <Border
                      Grid.Column="1"
                      Padding="7,3"
                      VerticalAlignment="Center"
                      Background="#2217191C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Pending" />
                  </Border>
                </Grid>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Region" />
                    <TextBlock
                        x:Name="SettingsRegionShortcutText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Shortcut not assigned" />
                  </StackPanel>
                  <Border
                      Grid.Column="1"
                      Padding="7,3"
                      VerticalAlignment="Center"
                      Background="#2217191C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Pending" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="HDR alerts settings section"
              AutomationProperties.HelpText="HDR alert behavior is displayed read-only until the dedicated settings story."
              Spacing="8">
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="HDR ALERTS" />
            <Border
                Padding="14,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Warnings" />
                  <TextBlock
                      x:Name="SettingsHdrAlertsText"
                      FontSize="11"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Alerts enabled by default" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SubtleTextBrush}"
                    Text="Read-only" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Output settings section"
              AutomationProperties.HelpText="Output preferences are placeholders until output settings behavior is implemented."
              Spacing="8">
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="OUTPUT" />
            <Border
                Padding="14,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
              <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Destination" />
                    <TextBlock
                        x:Name="SettingsOutputTargetText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Clipboard" />
                  </StackPanel>
                  <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Foreground="{StaticResource SubtleTextBrush}"
                      Text="Pending" />
                </Grid>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Save path" />
                    <TextBlock
                        x:Name="SettingsSavePathText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Default location pending" />
                  </StackPanel>
                  <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Foreground="{StaticResource SubtleTextBrush}"
                      Text="Disabled" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Clipboard settings section"
              AutomationProperties.HelpText="Clipboard options are shown read-only until output behavior is expanded."
              Spacing="8">
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="CLIPBOARD" />
            <Border
                Padding="14,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Copy as image" />
                  <TextBlock
                      x:Name="SettingsCopyAsImageText"
                      FontSize="11"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Enabled by default" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SubtleTextBrush}"
                    Text="Read-only" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Background behavior settings section"
              AutomationProperties.HelpText="Tray and background workflow arrive in Epic 7."
              Spacing="8">
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="BACKGROUND" />
            <Border
                Padding="14,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Tray workflow" />
                  <TextBlock
                      FontSize="11"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Minimize and background behavior arrive later" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SubtleTextBrush}"
                    Text="Pending" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="About settings section"
              AutomationProperties.HelpText="Version details arrive in the native about story."
              Spacing="8">
            <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{StaticResource MutedTextBrush}"
                Text="ABOUT" />
            <Border
                Padding="14,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Lumiere" />
                  <TextBlock
                      FontSize="11"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Native HDR screenshot tool" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource SubtleTextBrush}"
                    Text="Pending" />
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
