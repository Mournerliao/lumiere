<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource PanelBrush}"
      RequestedTheme="Dark">
    <Grid x:Name="MainPanelRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <Border
          x:Name="HeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="12">
            <Border
                Width="32"
                Height="32"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="8">
              <ic:FluentIcon
                  Foreground="{StaticResource AccentBrush}"
                  Icon="Layer"
                  IconSize="Size20"
                  IconVariant="Regular" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Lumiere" />
          </StackPanel>
          <Button
              x:Name="SettingsButton"
              Grid.Column="1"
              Width="28"
              Height="28"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Open the native settings shell without stopping the current capture session."
              AutomationProperties.Name="Open settings"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Settings">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="16"
                Glyph="&#xE713;" />
          </Button>
        </Grid>
      </Border>

      <Grid
          Grid.Row="1"
          Padding="20,18">
        <StackPanel
            VerticalAlignment="Center"
            Spacing="8">

          <local:CaptureActionCard
              x:Name="SelectCaptureTargetButton"
              Background="{StaticResource SecondaryPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              Click="OnSelectCaptureTargetClick"
              Description="Capture the current display"
              Icon="Camera"
              IconBackground="{StaticResource SecondaryPanelBrush}"
              IconBorderBrush="{StaticResource BorderBrush}"
              IconForeground="{StaticResource MutedTextBrush}"
              SecondaryForeground="{StaticResource MutedTextBrush}"
              ShortcutForeground="{StaticResource SubtleTextBrush}"
              ShortcutText="Not assigned"
              Title="Full Screen" />

          <local:CaptureActionCard
              x:Name="RegionSelectButton"
              Background="{StaticResource SecondaryPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              Click="OnRegionCaptureClick"
              Description="Select a region by dragging"
              Icon="Layer"
              IconBackground="{StaticResource SecondaryPanelBrush}"
              IconBorderBrush="{StaticResource BorderBrush}"
              IconForeground="{StaticResource MutedTextBrush}"
              SecondaryForeground="{StaticResource MutedTextBrush}"
              ShortcutForeground="{StaticResource SubtleTextBrush}"
              ShortcutText="Not assigned"
              Title="Region" />

        </StackPanel>
      </Grid>

      <Border
          Grid.Row="2"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <FontIcon
                x:Name="TrustStatusGlyph"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Foreground="{StaticResource MutedTextBrush}"
                Glyph="&#xE121;" />
            <Ellipse
                x:Name="TrustStatusDot"
                Width="6"
                Height="6"
                VerticalAlignment="Center"
                Fill="{StaticResource MutedTextBrush}" />
            <TextBlock
                x:Name="TrustStatusLabel"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="Checking HDR" />
          </StackPanel>
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="11"
              Foreground="{StaticResource MutedTextBrush}"
              AutomationProperties.Name="Minimize to background pending"
              Text="Minimize"
              ToolTipService.ToolTip="Background tray behavior arrives in Epic 7" />
        </Grid>
      </Border>
    </Grid>

    <Grid
        x:Name="SettingsPanelRoot"
        Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border
          x:Name="SettingsHeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button
              x:Name="SettingsBackButton"
              Width="32"
              Height="32"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Return to the main capture panel without stopping capture."
              AutomationProperties.Name="Back to main panel"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsBackButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Back">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="15"
                Glyph="&#xE72B;" />
          </Button>
          <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="1">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Settings" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="1"
          Padding="20,20,20,20"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
          <StackPanel
              AutomationProperties.Name="Shortcuts settings section"
              AutomationProperties.HelpText="Shortcut values are visible, but global registration and editing arrive in Epic 7."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE765;"
                Title="SHORTCUTS" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <Grid
                    MinHeight="56"
                    ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Full Screen" />
                  <Border
                      x:Name="SettingsFullscreenShortcutValuePill"
                      Grid.Column="1"
                      MinWidth="96"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      Background="#241D2024"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                    <TextBlock
                        x:Name="SettingsFullscreenShortcutValueText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Not assigned" />
                  </Border>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid
                    MinHeight="56"
                    ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Region" />
                  <Border
                      x:Name="SettingsRegionShortcutValuePill"
                      Grid.Column="1"
                      MinWidth="96"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      Background="#241D2024"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                    <TextBlock
                        x:Name="SettingsRegionShortcutValueText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Not assigned" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock
                Margin="16,-3,0,0"
                FontSize="10"
                Foreground="{StaticResource MutedTextBrush}"
                Text="Global registration arrives in Epic 7" />
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="HDR alerts settings section"
              AutomationProperties.HelpText="HDR alert preference can be changed for the current session."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE7F4;"
                Title="HDR" />
            <Border
                Padding="16,0"
                HorizontalAlignment="Stretch"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="HDR alerts" />
                    <TextBlock
                        x:Name="SettingsHdrAlertsHelperText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="When HDR is unavailable"
                        TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Button
                      x:Name="SettingsHdrAlertsButton"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Show warnings when HDR is unavailable, degraded, unsupported, or failed."
                      AutomationProperties.Name="HDR alerts"
                      Click="OnSettingsHdrAlertsButtonClick"
                      IsEnabled="False"
                      Style="{StaticResource SettingsSwitchButtonStyle}">
                    <Border
                        x:Name="SettingsHdrAlertsSwitchTrack"
                        Width="48"
                        Height="28"
                        Background="{StaticResource SwitchTrackOffBrush}"
                        CornerRadius="14">
                      <Ellipse
                          x:Name="SettingsHdrAlertsSwitchKnob"
                          Width="20"
                          Height="20"
                          Margin="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Fill="{StaticResource SwitchKnobOffBrush}" />
                    </Border>
                  </Button>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Export" />
                    <TextBlock
                        x:Name="SettingsExportHelperText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text=""
                        TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Border
                      x:Name="SettingsExportSegmentsPanel"
                      Grid.Column="1"
                      Width="176"
                      Height="48"
                      Padding="4"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="Export profile controls are validation-scoped until encoder metadata and Windows validation exist."
                      AutomationProperties.Name="Export"
                      Background="#2217191C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                    <Grid ColumnSpacing="4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button
                          x:Name="SettingsExportHdr10Segment"
                          Style="{StaticResource SegmentButtonStyle}">
                        <TextBlock
                            x:Name="SettingsExportHdr10Text"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="HDR10" />
                      </Button>
                      <Button
                          x:Name="SettingsExportP3Segment"
                          Grid.Column="1"
                          Style="{StaticResource SegmentButtonStyle}">
                        <TextBlock
                            x:Name="SettingsExportP3Text"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="P3" />
                      </Button>
                      <Button
                          x:Name="SettingsExportSrgbSegment"
                          Grid.Column="2"
                          Style="{StaticResource SegmentButtonStyle}">
                        <TextBlock
                            x:Name="SettingsExportSrgbText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="sRGB" />
                      </Button>
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Output settings section"
              AutomationProperties.HelpText="Supported output destination and clipboard image preferences can be changed here."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE8B7;"
                Title="OUTPUT" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <StackPanel
                    Padding="0,16,0,18"
                    Spacing="10">
                  <TextBlock
                      CharacterSpacing="80"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="DESTINATION" />
                  <TextBlock
                      x:Name="SettingsDestinationHelperText"
                      FontSize="11"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Output target policy is active"
                      TextWrapping="WrapWholeWords" />
                  <Border
                      Height="48"
                      Padding="4"
                      AutomationProperties.HelpText="Choose where completed captures are written."
                      AutomationProperties.Name="Destination"
                      Background="#2217191C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                    <Grid ColumnSpacing="4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button
                          x:Name="SettingsDestinationClipboardSegment"
                          Click="OnSettingsDestinationClipboardClick"
                          Style="{StaticResource SegmentButtonStyle}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0">
                          <TextBlock
                              x:Name="SettingsDestinationClipboardText"
                              HorizontalAlignment="Center"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Text="Clipboard" />
                        </StackPanel>
                      </Button>
                      <Button
                          x:Name="SettingsDestinationFolderSegment"
                          Grid.Column="1"
                          Click="OnSettingsDestinationFolderClick"
                          Style="{StaticResource SegmentButtonStyle}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0">
                          <TextBlock
                              x:Name="SettingsDestinationFolderText"
                              HorizontalAlignment="Center"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Text="Folder" />
                        </StackPanel>
                      </Button>
                      <Button
                          x:Name="SettingsDestinationBothSegment"
                          Grid.Column="2"
                          Click="OnSettingsDestinationBothClick"
                          Style="{StaticResource SegmentButtonStyle}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0">
                          <TextBlock
                              x:Name="SettingsDestinationBothText"
                              HorizontalAlignment="Center"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Text="Both" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Save path" />
                    <TextBlock
                        x:Name="SettingsSavePathHelperText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Folder output uses the configured path; editing remains read-only"
                        TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Border
                      x:Name="SettingsSavePathValuePill"
                      Grid.Column="1"
                      MaxWidth="150"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="Folder output uses this configured path. Editing remains read-only until picker behavior is implemented."
                      AutomationProperties.Name="Save path"
                      Background="#241D2024"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                    <TextBlock
                        x:Name="SettingsSavePathValueText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Not configured"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                  </Border>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="After capture" />
                    <TextBlock
                        x:Name="SettingsAfterCaptureHelperText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Runs only when folder output produces a file artifact"
                        TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Button
                      x:Name="SettingsOpenAfterCaptureButton"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Runs only when folder output produces a file artifact."
                      AutomationProperties.Name="After capture action"
                      IsEnabled="False"
                      Style="{StaticResource SettingsSwitchButtonStyle}">
                    <Border
                        x:Name="SettingsOpenAfterCaptureSwitchTrack"
                        Width="48"
                        Height="28"
                        Background="{StaticResource SwitchTrackOffBrush}"
                        CornerRadius="14">
                      <Ellipse
                          x:Name="SettingsOpenAfterCaptureSwitchKnob"
                          Width="20"
                          Height="20"
                          Margin="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Fill="{StaticResource SwitchKnobOffBrush}" />
                    </Border>
                  </Button>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Timestamp" />
                    <TextBlock
                        x:Name="SettingsTimestampHelperText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Pending output behavior"
                        TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Button
                      x:Name="SettingsTimestampButton"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Timestamp naming is display-only until settings persistence is implemented."
                      AutomationProperties.Name="Timestamp naming"
                      IsEnabled="False"
                      Style="{StaticResource SettingsSwitchButtonStyle}">
                    <Border
                        x:Name="SettingsTimestampSwitchTrack"
                        Width="48"
                        Height="28"
                        Background="{StaticResource SwitchTrackOffBrush}"
                        CornerRadius="14">
                      <Ellipse
                          x:Name="SettingsTimestampSwitchKnob"
                          Width="20"
                          Height="20"
                          Margin="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Fill="{StaticResource SwitchKnobOffBrush}" />
                    </Border>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Clipboard settings section"
              AutomationProperties.HelpText="Clipboard options are shown read-only; configured output behavior consumes the saved preference."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE8C8;"
                Title="CLIPBOARD" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <Grid MinHeight="64" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                  <TextBlock
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Copy as image" />
                  <TextBlock
                      x:Name="SettingsCopyAsImageHelperText"
                      FontSize="11"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Basic clipboard usability, not validated HDR preservation"
                      TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    x:Name="SettingsCopyAsImageButton"
                    Grid.Column="1"
                    AutomationProperties.HelpText="Copy-as-image controls basic clipboard usability and does not mean validated HDR preservation."
                    AutomationProperties.Name="Copy as image"
                    Click="OnSettingsCopyAsImageButtonClick"
                    Style="{StaticResource SettingsSwitchButtonStyle}">
                  <Border
                      x:Name="SettingsCopyAsImageSwitchTrack"
                      Width="48"
                      Height="28"
                      Background="{StaticResource SwitchTrackOffBrush}"
                      CornerRadius="14">
                    <Ellipse
                        x:Name="SettingsCopyAsImageSwitchKnob"
                        Width="20"
                        Height="20"
                        Margin="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SwitchKnobOffBrush}" />
                  </Border>
                </Button>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="About settings section"
              AutomationProperties.HelpText="Version details arrive in the native about story."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE946;"
                Title="ABOUT" />
            <Border
                x:Name="SettingsAboutInfoPanel"
                Padding="16,12"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel Spacing="4">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      x:Name="SettingsAboutAppNameText"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Lumiere" />
                  <TextBlock
                      x:Name="SettingsAboutVersionText"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontSize="12"
                      FontFamily="Cascadia Mono, Consolas"
                      Foreground="{StaticResource SubtleTextBrush}"
                      Text="Version" />
                </Grid>
                <TextBlock
                    x:Name="SettingsAboutDescriptionText"
                    FontSize="11"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Native screenshot reference for HDR-first capture."
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
