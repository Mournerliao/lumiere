<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="#F3F4F6">
    <SwapChainPanel
        x:Name="PreviewSwapChainPanel"
        HorizontalAlignment="Left"
        VerticalAlignment="Top" />

    <Border
        Margin="16"
        Padding="16"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="#F9FAFB"
        BorderBrush="#D1D5DB"
        BorderThickness="1"
        CornerRadius="12">
      <StackPanel MaxWidth="360" Spacing="12">
        <TextBlock
            Foreground="#111827"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Lumiere" />
        <TextBlock
            x:Name="PreviewStatusLabelTextBlock"
            Foreground="#111827"
            FontSize="16"
            FontWeight="SemiBold"
            Text="Initializing preview" />
        <TextBlock
            x:Name="PreviewStatusMessageTextBlock"
            Foreground="#1F2937"
            Text="Choose a display or window to start the minimal HDR preview." />
        <TextBlock
            x:Name="PreviewTechnicalDetailTextBlock"
            Foreground="#374151"
            TextWrapping="Wrap" />
        <Button
            x:Name="SelectCaptureTargetButton"
            Click="OnSelectCaptureTargetClick"
            Content="Select Capture Target" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
