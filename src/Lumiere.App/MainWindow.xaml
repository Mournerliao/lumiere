<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource AppBackgroundBrush}"
      RequestedTheme="Dark">
    <Grid Padding="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel
          Grid.Row="0"
          Margin="0,0,0,16"
          Orientation="Horizontal"
          Spacing="12">
        <Border
            Width="32"
            Height="32"
            Background="{StaticResource AccentBrush}"
            CornerRadius="6">
          <FontIcon
              FontFamily="Segoe Fluent Icons"
              FontSize="15"
              Foreground="{StaticResource TextBrush}"
              Glyph="&#xE722;" />
        </Border>
        <TextBlock
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextBrush}"
            Text="Lumiere" />
      </StackPanel>

      <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          VerticalScrollMode="Auto">
        <StackPanel Spacing="18">

          <StackPanel Spacing="12">
            <Button
                x:Name="SelectCaptureTargetButton"
                Background="{StaticResource AccentBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                CornerRadius="6"
                Foreground="{StaticResource TextBrush}"
                MinHeight="40"
                BorderThickness="0"
                Padding="16,8"
                Click="OnSelectCaptureTargetClick">
              <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="#FF0078D4" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF0086F0" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF006CBE" />
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#330078D4" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00000000" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00000000" />
                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
              </Button.Resources>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Glyph="&#xE722;" />
                <TextBlock FontSize="14" Text="Fullscreen" />
              </StackPanel>
            </Button>

            <local:CaptureActionCard
                x:Name="RegionSelectButton"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentBorderBrush}"
                Click="OnRegionCaptureClick"
                Description="Select a region by dragging"
                Glyph="&#xE8B0;"
                IconBackground="{StaticResource AccentBrush}"
                IconBorderBrush="{StaticResource AccentBrush}"
                IconForeground="{StaticResource TextBrush}"
                SecondaryForeground="{StaticResource MutedTextBrush}"
                ShortcutForeground="{StaticResource SubtleTextBrush}"
                ShortcutText=""
                Title="Region" />
          </StackPanel>

          <Border
              Padding="14"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="6">
              <TextBlock
                  x:Name="CaptureStatusTitle"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource TextBrush}"
                  Text="Ready" />
              <TextBlock
                  x:Name="CaptureStatusMessage"
                  FontSize="12"
                  Foreground="{StaticResource MutedTextBrush}"
                  Text="Select a capture mode to begin."
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="CaptureStatusDetail"
                  FontFamily="Consolas"
                  FontSize="10"
                  Foreground="{StaticResource SubtleTextBrush}"
                  TextWrapping="WrapWholeWords"
                  Visibility="Collapsed" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Border
          Grid.Row="2"
          Padding="2,12,0,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Ellipse
              Width="8"
              Height="8"
              VerticalAlignment="Center"
              Fill="{StaticResource SuccessBrush}" />
          <TextBlock
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{StaticResource MutedTextBrush}"
              Text="Ready" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid
        x:Name="TitleBarDragArea"
        Height="44"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="Transparent" />
  </Grid>
</Window>
