<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource DashboardBackgroundBrush}"
      RequestedTheme="Dark">
    <Grid
        Padding="16"
        ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
          Grid.Column="0"
          Padding="16,20"
          Background="{StaticResource DashboardPanelBrush}"
          BorderBrush="{StaticResource DashboardBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <Grid RowSpacing="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel
              Grid.Row="0"
              Margin="2,0,0,0"
              Orientation="Horizontal"
              Spacing="12">
            <Border
                Width="32"
                Height="32"
                Background="{StaticResource DashboardAccentBrush}"
                CornerRadius="6">
              <FontIcon
                  FontFamily="Segoe Fluent Icons"
                  FontSize="15"
                  Foreground="{StaticResource DashboardTextBrush}"
                  Glyph="&#xE722;" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock
                  FontSize="14"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource DashboardTextBrush}"
                  Text="Lumiere" />
              <TextBlock
                  CharacterSpacing="140"
                  FontSize="10"
                  Foreground="{StaticResource DashboardMutedTextBrush}"
                  Text="CAPTURE TOOL" />
            </StackPanel>
          </StackPanel>

          <ScrollViewer
              Grid.Row="1"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
              <StackPanel>
                <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="MAIN" />
                <Button
                    x:Name="CaptureHomeNavigationItem"
                    Background="{StaticResource DashboardAccentSoftBrush}"
                    BorderBrush="Transparent"
                    Foreground="{StaticResource DashboardAccentBrush}"
                    Style="{StaticResource DashboardNavButtonStyle}">
                  <Grid>
                    <Border
                        Width="2"
                        Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="-12,0,0,0"
                        Background="{StaticResource DashboardAccentBrush}"
                        CornerRadius="0,2,2,0" />
                    <StackPanel
                        Margin="0,0,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                      <FontIcon
                          Width="20"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="14"
                          Glyph="&#xE80F;" />
                      <TextBlock
                          VerticalAlignment="Center"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Text="Dashboard" />
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <Border
              Grid.Row="2"
              Padding="2,16,0,0"
              BorderBrush="{StaticResource DashboardBorderBrush}"
              BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Ellipse
                  Width="8"
                  Height="8"
                  VerticalAlignment="Center"
                  Fill="{StaticResource DashboardSuccessBrush}" />
              <TextBlock
                  VerticalAlignment="Center"
                  FontSize="12"
                  Foreground="{StaticResource DashboardMutedTextBrush}"
                  Text="Service Running" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid
          Grid.Column="1">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
          <StackPanel Margin="0,24,8,8" Spacing="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DashboardTextBrush}"
                    Text="Capture Home" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="{StaticResource DashboardMutedTextBrush}"
                    Text="Quick actions and current system status." />
              </StackPanel>

              <Button
                  x:Name="SelectCaptureTargetButton"
                  Grid.Column="1"
                  Background="{StaticResource DashboardAccentBrush}"
                  BorderBrush="{StaticResource DashboardAccentBrush}"
                  CornerRadius="6"
                  Foreground="{StaticResource DashboardTextBrush}"
                  MinHeight="40"
                  BorderThickness="0"
                  Padding="16,8"
                  Click="OnSelectCaptureTargetClick">
                <Button.Resources>
                  <SolidColorBrush x:Key="ButtonBackground" Color="#FF0078D4" />
                  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF0086F0" />
                  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF006CBE" />
                  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#330078D4" />
                  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00000000" />
                  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00000000" />
                  <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <FontIcon
                      FontFamily="Segoe Fluent Icons"
                      FontSize="14"
                      Glyph="&#xE722;" />
                  <TextBlock FontSize="14" Text="Capture Now" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <local:CaptureActionCard
                  x:Name="RegionSelectButton"
                  Grid.Column="0"
                  Background="{StaticResource DashboardAccentSoftBrush}"
                  BorderBrush="{StaticResource DashboardAccentBorderBrush}"
                  Click="OnSelectCaptureTargetClick"
                  Description="Draw a custom capture area"
                  Glyph="&#xE8B0;"
                  IconBackground="{StaticResource DashboardAccentBrush}"
                  IconBorderBrush="{StaticResource DashboardAccentBrush}"
                  IconForeground="{StaticResource DashboardTextBrush}"
                  SecondaryForeground="{StaticResource DashboardMutedTextBrush}"
                  ShortcutForeground="{StaticResource DashboardSubtleTextBrush}"
                  ShortcutText="Win + Shift + S"
                  Title="Region Select" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid
        x:Name="TitleBarDragArea"
        Height="44"
        Margin="312,0,0,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="Transparent" />
  </Grid>
</Window>
