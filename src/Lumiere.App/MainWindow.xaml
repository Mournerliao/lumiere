<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource AppBackgroundBrush}"
      RequestedTheme="Dark">
    <Grid Padding="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid
          Grid.Row="0"
          Margin="0,0,0,16"
          ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border
              Width="32"
              Height="32"
              Background="{StaticResource AccentSoftBrush}"
              BorderBrush="{StaticResource AccentBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                FontSize="15"
                Foreground="{StaticResource AccentBrush}"
                Glyph="&#xE722;" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Lumiere" />
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource SubtleTextBrush}"
                Text="Native HDR capture" />
          </StackPanel>
        </StackPanel>
        <Button
            x:Name="SettingsButton"
            Grid.Column="1"
            Width="34"
            Height="34"
            VerticalAlignment="Center"
            AutomationProperties.Name="Settings pending"
            IsEnabled="False"
            ToolTipService.ToolTip="Settings navigation arrives in Story 5.2">
          <FontIcon
              FontFamily="Segoe Fluent Icons"
              FontSize="15"
              Glyph="&#xE713;" />
        </Button>
      </Grid>

      <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          VerticalScrollMode="Auto">
        <StackPanel Spacing="18">

          <StackPanel Spacing="12">
            <local:CaptureActionCard
                x:Name="SelectCaptureTargetButton"
                Background="{StaticResource AccentBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                Click="OnSelectCaptureTargetClick"
                Description="Capture the current display"
                Glyph="&#xE722;"
                IconBackground="{StaticResource TextBrush}"
                IconBorderBrush="{StaticResource TextBrush}"
                IconForeground="{StaticResource AccentBrush}"
                SecondaryForeground="{StaticResource TextBrush}"
                ShortcutForeground="{StaticResource TextBrush}"
                ShortcutText="Not assigned"
                Title="Full Screen" />

            <local:CaptureActionCard
                x:Name="RegionSelectButton"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentBorderBrush}"
                Click="OnRegionCaptureClick"
                Description="Select a region by dragging"
                Glyph="&#xE8B0;"
                IconBackground="{StaticResource AccentBrush}"
                IconBorderBrush="{StaticResource AccentBrush}"
                IconForeground="{StaticResource TextBrush}"
                SecondaryForeground="{StaticResource MutedTextBrush}"
                ShortcutForeground="{StaticResource SubtleTextBrush}"
                ShortcutText="Not assigned"
                Title="Region" />
          </StackPanel>

          <Border
              Padding="14"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
            <StackPanel Spacing="6">
              <TextBlock
                  x:Name="CaptureStatusTitle"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource TextBrush}"
                  Text="Ready" />
              <TextBlock
                  x:Name="CaptureStatusMessage"
                  FontSize="12"
                  Foreground="{StaticResource MutedTextBrush}"
                  Text="Select a capture mode to begin."
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="CaptureStatusDetail"
                  FontFamily="Consolas"
                  FontSize="10"
                  Foreground="{StaticResource SubtleTextBrush}"
                  TextWrapping="WrapWholeWords"
                  Visibility="Collapsed" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Border
          Grid.Row="2"
          Padding="2,12,0,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon
                x:Name="TrustStatusGlyph"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="13"
                Foreground="{StaticResource MutedTextBrush}"
                Glyph="&#xE9D5;" />
            <Ellipse
                x:Name="TrustStatusDot"
                Width="7"
                Height="7"
                VerticalAlignment="Center"
                Fill="{StaticResource MutedTextBrush}" />
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock
                  x:Name="TrustStatusLabel"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource MutedTextBrush}"
                  Text="Checking HDR" />
              <TextBlock
                  x:Name="TrustStatusMessage"
                  FontSize="10"
                  Foreground="{StaticResource SubtleTextBrush}"
                  Text="Select a capture mode to begin."
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
          <Button
              Grid.Column="1"
              MinWidth="0"
              Padding="8,4"
              VerticalAlignment="Center"
              AutomationProperties.Name="Minimize to background pending"
              IsEnabled="False"
              ToolTipService.ToolTip="Background tray behavior arrives in Epic 7">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <FontIcon
                  FontFamily="Segoe Fluent Icons"
                  FontSize="11"
                  Glyph="&#xE921;" />
              <TextBlock FontSize="11" Text="Minimize" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
    <Grid
        x:Name="TitleBarDragArea"
        Height="44"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="Transparent" />
  </Grid>
</Window>
