<Window
    x:Class="Lumiere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:Lumiere.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <Grid
      x:Name="RootGrid"
      Background="{StaticResource MicaSurfaceBrush}"
      RequestedTheme="Dark">
    <Grid x:Name="MainPanelRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <Border
          x:Name="HeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="12">
            <Border
                Width="32"
                Height="32"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="8">
              <ic:FluentIcon
                  Foreground="{StaticResource AccentBrush}"
                  Icon="Layer"
                  IconSize="Size20"
                  IconVariant="Regular" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Lumiere" />
          </StackPanel>
          <Button
              x:Name="SettingsButton"
              Grid.Column="1"
              Width="28"
              Height="28"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Open the native settings shell without stopping the current capture session."
              AutomationProperties.Name="Open settings"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Settings">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="16"
                Glyph="&#xE713;" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="2"
          Padding="20,18"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

          <StackPanel Spacing="8">
            <local:CaptureActionCard
                x:Name="SelectCaptureTargetButton"
                Background="{StaticResource PrimaryActionBrush}"
                BorderBrush="{StaticResource PrimaryActionBorderBrush}"
                Click="OnSelectCaptureTargetClick"
                Description="Capture the current display"
                HoverBackground="{StaticResource PrimaryActionHoverBrush}"
                HoverBorderBrush="{StaticResource PrimaryActionHoverBorderBrush}"
                Icon="Camera"
                IconBackground="{StaticResource AccentSoftBrush}"
                IconBorderBrush="{StaticResource AccentBorderBrush}"
                IconForeground="{StaticResource AccentBrush}"
                SecondaryForeground="{StaticResource MutedTextBrush}"
                ShortcutForeground="{StaticResource TextBrush}"
                ShortcutText="Not assigned"
                Title="Full Screen" />

            <local:CaptureActionCard
                x:Name="RegionSelectButton"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                Click="OnRegionCaptureClick"
                Description="Select a region by dragging"
                HoverBackground="{StaticResource SecondaryPanelHoverBrush}"
                HoverBorderBrush="{StaticResource SecondaryBorderHoverBrush}"
                Icon="Layer"
                IconBackground="{StaticResource SecondaryPanelBrush}"
                IconBorderBrush="{StaticResource BorderBrush}"
                IconForeground="{StaticResource MutedTextBrush}"
                SecondaryForeground="{StaticResource MutedTextBrush}"
                ShortcutForeground="{StaticResource SubtleTextBrush}"
                ShortcutText="Not assigned"
                Title="Region" />
          </StackPanel>

          <Grid
              Margin="0,8,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="TargetHdrStatusPill"
                MinHeight="66"
                Padding="12,10"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon
                      x:Name="TargetHdrStatusGlyph"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="13"
                      Foreground="{StaticResource MutedTextBrush}"
                      Glyph="&#xE121;" />
                  <Ellipse
                      x:Name="TargetHdrStatusDotInline"
                      Width="6"
                      Height="6"
                      VerticalAlignment="Center"
                      Fill="{StaticResource MutedTextBrush}" />
                  <TextBlock
                      x:Name="TargetHdrStatusLabel"
                      VerticalAlignment="Center"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Checking HDR"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    x:Name="TargetHdrStatusDetail"
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="HDR preview status is being checked."
                    TextWrapping="WrapWholeWords" />
              </StackPanel>
            </Border>
            <Border
                x:Name="FidelityClaimStatusPill"
                Grid.Column="1"
                MinHeight="66"
                Padding="12,10"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon
                      x:Name="FidelityClaimStatusGlyph"
                      VerticalAlignment="Center"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="13"
                      Foreground="{StaticResource MutedTextBrush}"
                      Glyph="&#xEA39;" />
                  <Ellipse
                      x:Name="FidelityClaimStatusDot"
                      Width="6"
                      Height="6"
                      VerticalAlignment="Center"
                      Fill="{StaticResource MutedTextBrush}" />
                  <TextBlock
                      x:Name="FidelityClaimStatusLabel"
                      VerticalAlignment="Center"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Unvalidated"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    x:Name="FidelityClaimStatusDetail"
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="No fidelity claim is made for this path."
                    TextWrapping="WrapWholeWords" />
              </StackPanel>
            </Border>
          </Grid>

          <Border
              x:Name="OutputProfilePanel"
              Margin="0,6,0,0"
              Padding="12,10"
              Background="{StaticResource SecondaryPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock
                    x:Name="OutputProfileLabel"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"
                    Text="Output profile: sRGB" />
                <TextBlock
                    x:Name="OutputProfileDetail"
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Compatibility output; useful fallback, not the public release target."
                    TextWrapping="WrapWholeWords" />
              </StackPanel>
              <Border
                  Grid.Column="1"
                  Padding="8,4"
                  VerticalAlignment="Top"
                  Background="#241D2024"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
                <TextBlock
                    x:Name="OutputProfileStatusLabel"
                    FontSize="9"
                    FontWeight="Bold"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="Compat" />
              </Border>
            </Grid>
          </Border>

          <Border
              x:Name="OutputResultPanel"
              Margin="0,6,0,0"
              Padding="12,10"
              Background="{StaticResource SecondaryPanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    x:Name="OutputResultGlyph"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Foreground="{StaticResource SuccessBrush}"
                    Glyph="&#xE8C8;" />
                <StackPanel Spacing="1">
                  <TextBlock
                      x:Name="OutputResultTitle"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Ready" />
                  <TextBlock
                      FontSize="10"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Artifact result first, fidelity claim second." />
                </StackPanel>
              </StackPanel>
              <TextBlock
                  x:Name="OutputResultDetail"
                  FontSize="10"
                  Foreground="{StaticResource MutedTextBrush}"
                  Text="No capture output has completed yet."
                  TextWrapping="WrapWholeWords" />
              <TextBlock
                  x:Name="OutputResultFidelityDetail"
                  FontSize="10"
                  Foreground="{StaticResource MutedTextBrush}"
                  Text="Never implies HDR preservation unless the selected profile has target-aware evidence."
                  TextWrapping="WrapWholeWords" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <InfoBar
          x:Name="HdrAlertInfoBar"
          Grid.Row="3"
          Margin="12,0"
          Closed="OnHdrAlertInfoBarClosed"
          IsClosable="True"
          IsOpen="False"
          Severity="Warning"
          Visibility="Collapsed" />

      <Border
          Grid.Row="4"
          Padding="20,0"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="8">
            <FontIcon
                x:Name="TrustStatusGlyph"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Foreground="{StaticResource MutedTextBrush}"
                Glyph="&#xE121;" />
            <Ellipse
                x:Name="TrustStatusDot"
                Width="6"
                Height="6"
                VerticalAlignment="Center"
                Fill="{StaticResource MutedTextBrush}" />
            <TextBlock
                x:Name="TrustStatusLabel"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="Checking HDR" />
          </StackPanel>
          <Button
              x:Name="MinimizeButton"
              Grid.Column="1"
              Width="28"
              Height="28"
              MinWidth="0"
              VerticalAlignment="Center"
              IsEnabled="False"
              AutomationProperties.Name="Minimize to background"
              AutomationProperties.HelpText="Hide the window to the system tray. The app continues running in the background."
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnMinimizeButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Minimize to tray">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="14"
                Glyph="&#xE921;" />
          </Button>
        </Grid>
      </Border>

    </Grid>

    <Grid
        x:Name="SettingsPanelRoot"
        Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border
          x:Name="SettingsHeaderDragArea"
          Grid.Row="0"
          Padding="20,0"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button
              x:Name="SettingsBackButton"
              Width="32"
              Height="32"
              MinWidth="0"
              VerticalAlignment="Center"
              AutomationProperties.HelpText="Return to the main capture panel without stopping capture."
              AutomationProperties.Name="Back to main panel"
              Background="Transparent"
              BorderBrush="Transparent"
              Click="OnSettingsBackButtonClick"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="0"
              ToolTipService.ToolTip="Back">
            <FontIcon
                FontFamily="Segoe Fluent Icons"
                Foreground="{StaticResource MutedTextBrush}"
                FontSize="15"
                Glyph="&#xE72B;" />
          </Button>
          <StackPanel
              Grid.Column="1"
              VerticalAlignment="Center"
              Spacing="1">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"
                Text="Settings" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="1"
          Padding="20,20,20,20"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
          <StackPanel
              AutomationProperties.Name="Shortcuts settings section"
              AutomationProperties.HelpText="Keyboard shortcuts for fullscreen and region capture."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE765;"
                Title="SHORTCUTS" />
            <Border
                Padding="16,0"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <Grid
                    MinHeight="56"
                    ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Full Screen" />
                  <Button
                      x:Name="SettingsFullscreenShortcutButton"
                      Grid.Column="1"
                      MinWidth="108"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="Choose the fullscreen capture shortcut."
                      AutomationProperties.Name="Edit fullscreen shortcut"
                      Click="OnFullscreenShortcutClick">
                    <TextBlock
                        x:Name="SettingsFullscreenShortcutValueText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Not assigned" />
                  </Button>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid
                    MinHeight="56"
                    ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Region" />
                  <Button
                      x:Name="SettingsRegionShortcutButton"
                      Grid.Column="1"
                      MinWidth="108"
                      Padding="12,6"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="Choose the region capture shortcut."
                      AutomationProperties.Name="Edit region shortcut"
                      Click="OnRegionShortcutClick">
                    <TextBlock
                        x:Name="SettingsRegionShortcutValueText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Not assigned" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

          </StackPanel>

          <StackPanel
              AutomationProperties.Name="HDR alerts settings section"
              AutomationProperties.HelpText="HDR alert preference can be changed for the current session."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE7F4;"
                Title="HDR" />
            <Border
                Padding="16,0"
                HorizontalAlignment="Stretch"
                Background="{StaticResource SecondaryPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <StackPanel>
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                      VerticalAlignment="Center"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="HDR alerts" />
                  <ToggleSwitch
                      x:Name="SettingsHdrAlertsToggleSwitch"
                      Grid.Column="1"
                      AutomationProperties.HelpText="Show warnings when HDR is unavailable, degraded, unsupported, or failed."
                      AutomationProperties.Name="HDR alerts"
                      OffContent=""
                      OnContent=""
                      Toggled="OnSettingsHdrAlertsToggled" />
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <StackPanel Padding="0,12,0,14" Spacing="6">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                      <TextBlock
                          x:Name="SettingsTargetEvidenceTargetText"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextBrush}"
                          Text="No active target"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          x:Name="SettingsTargetEvidenceStageText"
                          FontSize="9"
                          Foreground="{StaticResource SubtleTextBrush}"
                          Text="Capture"
                          TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="8,4"
                        VerticalAlignment="Top"
                        Background="#241D2024"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                      <TextBlock
                          x:Name="SettingsTargetEvidenceScopeText"
                          FontSize="9"
                          FontWeight="Bold"
                          Foreground="{StaticResource MutedTextBrush}"
                          Text="Target unresolved" />
                    </Border>
                  </Grid>
                  <TextBlock
                      x:Name="SettingsTargetEvidenceDetailText"
                      FontSize="10"
                      Foreground="{StaticResource MutedTextBrush}"
                      Text="Select a target before public release can replace the global HDR guess with target-aware evidence."
                      TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <Grid MinHeight="64" ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Target-aware state" />
                    <TextBlock
                        x:Name="SettingsTargetAwareStateHelpText"
                        FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Public release cannot use a global HDR guess."
                        TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Border
                      Grid.Column="1"
                      Padding="9,5"
                      VerticalAlignment="Center"
                      Background="#241D2024"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="7">
                    <TextBlock
                        x:Name="SettingsTargetAwareStateLabel"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Required" />
                  </Border>
                </Grid>
                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}" />
                <StackPanel Margin="0,0,0,14" Spacing="8">
                  <TextBlock
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Export" />
                  <Border
                      x:Name="SettingsExportOptionsPanel"
                      Width="176"
                      Padding="10,8"
                      AutomationProperties.HelpText="HDR10 and P3 stay unavailable until encoder metadata and Windows validation are complete."
                      AutomationProperties.Name="Export"
                      Background="#2217191C"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                    <StackPanel Spacing="6">
                      <Grid MinHeight="28" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="SettingsExportHdr10RadioButton"
                            AutomationProperties.Name="Export option HDR10"
                            Checked="OnSettingsExportProfileChecked"
                            GroupName="SettingsExportProfile"
                            Tag="HDR10">
                          <TextBlock
                              x:Name="SettingsExportHdr10Text"
                              FontSize="10"
                              FontWeight="SemiBold"
                              Text="HDR10" />
                        </RadioButton>
                        <TextBlock
                            x:Name="SettingsExportHdr10StatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="Validate" />
                      </Grid>
                      <Grid MinHeight="28" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="SettingsExportP3RadioButton"
                            AutomationProperties.Name="Export option P3"
                            Checked="OnSettingsExportProfileChecked"
                            GroupName="SettingsExportProfile"
                            Tag="P3">
                          <TextBlock
                              x:Name="SettingsExportP3Text"
                              FontSize="10"
                              FontWeight="SemiBold"
                              Text="P3" />
                        </RadioButton>
                        <TextBlock
                            x:Name="SettingsExportP3StatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="Build" />
                      </Grid>
                      <Grid MinHeight="28" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="SettingsExportSrgbRadioButton"
                            AutomationProperties.Name="Export option sRGB"
                            Checked="OnSettingsExportProfileChecked"
                            GroupName="SettingsExportProfile"
                            Tag="sRGB">
                          <TextBlock
                              x:Name="SettingsExportSrgbText"
                              FontSize="10"
                              FontWeight="SemiBold"
                              Text="sRGB" />
                        </RadioButton>
                        <TextBlock
                            x:Name="SettingsExportSrgbStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="Compat" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <TextBlock
                    x:Name="SettingsExportProfileHelpText"
                    FontSize="10"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text=""
                    TextWrapping="WrapWholeWords" />
                <StackPanel
                    Margin="0,0,0,14"
                    Spacing="6">
                  <TextBlock
                      FontSize="10"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextBrush}"
                      Text="Selected profile contract" />
                  <Grid
                      ColumnSpacing="10"
                      RowSpacing="5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="78" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="9"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="Source" />
                    <TextBlock
                        x:Name="SettingsOutputContractSourceText"
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="9"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="FP16/scRGB capture source"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Grid.Row="1"
                        FontSize="9"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="Destination" />
                    <TextBlock
                        x:Name="SettingsOutputContractDestinationText"
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="9"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Compatibility-converted sRGB artifact"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Grid.Row="2"
                        FontSize="9"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="Conversion" />
                    <TextBlock
                        x:Name="SettingsOutputContractConversionText"
                        Grid.Row="2"
                        Grid.Column="1"
                        FontSize="9"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Output is converted for common SDR destinations."
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Grid.Row="3"
                        FontSize="9"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="Metadata" />
                    <TextBlock
                        x:Name="SettingsOutputContractMetadataText"
                        Grid.Row="3"
                        Grid.Column="1"
                        FontSize="9"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="No HDR metadata is attached to the compatibility artifact."
                        TextWrapping="WrapWholeWords" />

                    <TextBlock
                        Grid.Row="4"
                        FontSize="9"
                        Foreground="{StaticResource SubtleTextBrush}"
                        Text="Viewer" />
                    <TextBlock
                        x:Name="SettingsOutputContractViewerText"
                        Grid.Row="4"
                        Grid.Column="1"
                        FontSize="9"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="Compatibility-oriented target-app checks are still required."
                        TextWrapping="WrapWholeWords" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel
              AutomationProperties.Name="Validation settings section"
              AutomationProperties.HelpText="Public HDR fidelity evidence required before release claims."
              Spacing="9">
            <local:SettingsSectionHeader
                IconGlyph="&#xE9D9;"
