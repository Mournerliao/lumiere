{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiere.local/protocol/platform-host/v1.schema.json",
  "title": "Lumiere platform host protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/getCapabilitiesRequest" },
    { "$ref": "#/$defs/captureRequest" },
    { "$ref": "#/$defs/capabilitiesResponse" },
    { "$ref": "#/$defs/captureResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "getCapabilitiesRequest": {
      "type": "object",
      "required": ["version", "id", "method", "params"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "getCapabilities" },
        "params": { "type": "object", "maxProperties": 0 }
      },
      "additionalProperties": false
    },
    "captureRequest": {
      "type": "object",
      "required": ["version", "id", "method", "params"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "capture" },
        "params": {
          "type": "object",
          "required": ["mode", "delivery"],
          "properties": {
            "mode": { "enum": ["region", "display"] },
            "delivery": { "enum": ["clipboard", "folder", "both"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "host-unavailable",
            "permission-denied",
            "capture-unavailable",
            "invalid-request",
            "unexpected-failure"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "contractVersion",
        "platform",
        "hostStatus",
        "captureModes",
        "hdrCapture",
        "outputProfiles"
      ],
      "properties": {
        "contractVersion": { "const": 1 },
        "platform": { "enum": ["macos", "windows"] },
        "hostStatus": { "enum": ["available", "unavailable"] },
        "captureModes": {
          "type": "array",
          "items": { "enum": ["region", "display"] },
          "uniqueItems": true
        },
        "hdrCapture": { "enum": ["supported", "unavailable", "unvalidated"] },
        "outputProfiles": {
          "type": "array",
          "prefixItems": [{ "const": "srgb-visual-match" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "unavailableReason": { "$ref": "#/$defs/failure" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "hostStatus": { "const": "unavailable" } } },
          "then": {
            "properties": { "unavailableReason": { "$ref": "#/$defs/failure" } },
            "required": ["unavailableReason"]
          }
        }
      ]
    },
    "captureResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "sourceDynamicRange", "artifact"],
          "properties": {
            "status": { "const": "success" },
            "sourceDynamicRange": { "enum": ["sdr", "hdr"] },
            "artifact": {
              "type": "object",
              "required": ["profile", "delivery"],
              "properties": {
                "profile": { "const": "srgb-visual-match" },
                "delivery": { "enum": ["clipboard", "folder", "both"] },
                "filePath": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "cancelled" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "failure"],
          "properties": {
            "status": { "const": "failed" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      ]
    },
    "capabilitiesResponse": {
      "type": "object",
      "required": ["version", "id", "result"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "result": { "$ref": "#/$defs/capabilities" }
      },
      "additionalProperties": false
    },
    "captureResponse": {
      "type": "object",
      "required": ["version", "id", "result"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "result": { "$ref": "#/$defs/captureResult" }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["version", "id", "error"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/failure" }
      },
      "additionalProperties": false
    }
  }
}
