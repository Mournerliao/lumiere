{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiere.local/protocol/platform-host/v2.schema.json",
  "title": "Lumiere platform host protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/getCapabilitiesRequest" },
    { "$ref": "#/$defs/captureRequest" },
    { "$ref": "#/$defs/capabilitiesResponse" },
    { "$ref": "#/$defs/captureResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "getCapabilitiesRequest": {
      "type": "object",
      "required": ["version", "id", "method", "params"],
      "properties": {
        "version": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "getCapabilities" },
        "params": { "type": "object", "maxProperties": 0 }
      },
      "additionalProperties": false
    },
    "captureRequest": {
      "type": "object",
      "required": ["version", "id", "method", "params"],
      "properties": {
        "version": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "method": { "const": "capture" },
        "params": {
          "oneOf": [
            { "$ref": "#/$defs/displayCaptureParams" },
            { "$ref": "#/$defs/regionCaptureParams" }
          ]
        }
      },
      "additionalProperties": false
    },
    "displayCaptureParams": {
      "type": "object",
      "required": ["mode", "delivery"],
      "properties": {
        "mode": { "const": "display" },
        "delivery": { "$ref": "#/$defs/outputDelivery" }
      },
      "additionalProperties": false
    },
    "regionCaptureParams": {
      "type": "object",
      "required": ["mode", "delivery", "targetId", "geometry"],
      "properties": {
        "mode": { "const": "region" },
        "delivery": { "$ref": "#/$defs/outputDelivery" },
        "targetId": { "type": "string", "minLength": 1 },
        "geometry": { "$ref": "#/$defs/captureGeometry" }
      },
      "additionalProperties": false
    },
    "outputDelivery": {
      "enum": ["clipboard", "folder", "both"]
    },
    "captureGeometry": {
      "type": "object",
      "required": ["coordinateSpace", "x", "y", "width", "height"],
      "properties": {
        "coordinateSpace": { "const": "target-logical" },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "host-unavailable",
            "permission-denied",
            "capture-unavailable",
            "delivery-unavailable",
            "delivery-failed",
            "invalid-request",
            "unexpected-failure"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "captureTarget": {
      "type": "object",
      "required": ["id", "logicalSize"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "logicalSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "contractVersion",
        "platform",
        "hostStatus",
        "captureModes",
        "deliveryTargets",
        "hdrCapture",
        "outputProfiles"
      ],
      "properties": {
        "contractVersion": { "const": 2 },
        "platform": { "enum": ["macos", "windows"] },
        "hostStatus": { "enum": ["available", "unavailable"] },
        "captureModes": {
          "type": "array",
          "items": { "enum": ["region", "display"] },
          "uniqueItems": true
        },
        "deliveryTargets": {
          "type": "array",
          "items": { "enum": ["clipboard", "folder"] },
          "uniqueItems": true
        },
        "hdrCapture": { "enum": ["supported", "unavailable", "unvalidated"] },
        "outputProfiles": {
          "type": "array",
          "prefixItems": [{ "const": "srgb-visual-match" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "activeTarget": { "$ref": "#/$defs/captureTarget" },
        "unavailableReason": { "$ref": "#/$defs/failure" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "hostStatus": { "const": "unavailable" } } },
          "then": {
            "properties": { "unavailableReason": { "$ref": "#/$defs/failure" } },
            "required": ["unavailableReason"]
          }
        },
        {
          "if": {
            "properties": {
              "captureModes": {
                "type": "array",
                "contains": { "const": "region" }
              }
            }
          },
          "then": {
            "properties": { "activeTarget": { "$ref": "#/$defs/captureTarget" } },
            "required": ["activeTarget"]
          }
        }
      ]
    },
    "deliveryResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["target", "status"],
          "properties": {
            "target": { "const": "clipboard" },
            "status": { "const": "success" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "status", "filePath"],
          "properties": {
            "target": { "const": "folder" },
            "status": { "const": "success" },
            "filePath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target", "status", "failure"],
          "properties": {
            "target": { "enum": ["clipboard", "folder"] },
            "status": { "const": "failed" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      ]
    },
    "captureResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "sourceDynamicRange", "outputProfile", "deliveries"],
          "properties": {
            "status": { "const": "completed" },
            "sourceDynamicRange": { "enum": ["sdr", "hdr"] },
            "outputProfile": { "const": "srgb-visual-match" },
            "deliveries": {
              "type": "array",
              "items": { "$ref": "#/$defs/deliveryResult" },
              "minItems": 1,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "cancelled" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "failure"],
          "properties": {
            "status": { "const": "failed" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      ]
    },
    "capabilitiesResponse": {
      "type": "object",
      "required": ["version", "id", "result"],
      "properties": {
        "version": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "result": { "$ref": "#/$defs/capabilities" }
      },
      "additionalProperties": false
    },
    "captureResponse": {
      "type": "object",
      "required": ["version", "id", "result"],
      "properties": {
        "version": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "result": { "$ref": "#/$defs/captureResult" }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["version", "id", "error"],
      "properties": {
        "version": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/failure" }
      },
      "additionalProperties": false
    }
  }
}
